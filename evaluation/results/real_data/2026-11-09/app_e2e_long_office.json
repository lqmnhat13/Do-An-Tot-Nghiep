 "spoken": [
  {
   "t": 3.0,
   "text": "Hệ thống đã sẵn sàng hỗ trợ bạn."
  },
  {
   "t": 8.5,
   "text": "Chú ý, có ghế phía trước, ở rất gần"
  },
  {
   "t": 12.1,
   "text": "Chú ý, có tủ lạnh phía trước, ở rất gần"
  },
  {
   "t": 15.9,
   "text": "Chú ý, có vật cản phía trước, ở rất gần"
  },
  {
   "t": 21.1,
   "text": "Chú ý, có tủ lạnh phía trước, ở rất gần"
  },
  {
   "t": 23.2,
   "text": "<<OCR: True>>"
  },
  {
   "t": 23.2,
   "text": "Đã chuyển sang OCR. Cảnh báo vật cản đã tắt."
  },
  {
   "t": 25.9,
   "text": "Đang xử lý đọc chữ..."
